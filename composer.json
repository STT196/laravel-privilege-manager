{
    "name": "stt196/laravel-privilege-manager",
    "description": "A robust, security-hardened, and performance-optimized privilege/permission management system for Laravel applications with menu-based access control.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/STT196/laravel-privilege-manager",
    "authors": [
        {
            "name": "STT196",
            "email": "stt196@example.com"
        }
    ],
    "keywords": [
        "laravel",
        "privilege",
        "permissions",
        "access-control",
        "authorization",
        "security",
        "middleware",
        "menu"
    ],
    "support": {
        "issues": "https://github.com/STT196/laravel-privilege-manager/issues",
        "source": "https://github.com/STT196/laravel-privilege-manager",
        "docs": "https://github.com/STT196/laravel-privilege-manager#readme"
    },
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0 || ^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0",
        "nunomaduro/collision": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelPrivilegeManager\\": "src/",
            "LaravelPrivilegeManager\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/Helpers/privilege_helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelPrivilegeManager\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "lint": "php -l src/Services/PrivilegeService.php && php -l src/Middleware/CheckPrivilege.php && php -l src/Providers/PrivilegeManagerServiceProvider.php",
        "setup-check": "bash setup-check.sh"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelPrivilegeManager\\Providers\\PrivilegeManagerServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/tests",
            "/setup-check.sh",
            "/.gitignore"
        ]
    }
}
